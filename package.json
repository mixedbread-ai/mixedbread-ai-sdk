{
  "name": "@mixedbread/ai-sdk",
  "version": "0.0.1",
  "description": "Mixedbread provider for the Vercel AI SDK - the toast-1 language model with hosted store retrieval",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v4": {
      "types": "./dist/v4/index.d.ts",
      "import": "./dist/v4/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/v4/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "smoke": "tsx --env-file=.env src/smoke.ts"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "provider",
    "toast-1",
    "mixedbread",
    "llm",
    "rag",
    "search"
  ],
  "author": "Mixedbread",
  "license": "MIT",
  "homepage": "https://github.com/mixedbread-ai/mixedbread-ai-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixedbread-ai/mixedbread-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mixedbread-ai/mixedbread-ai-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@ai-sdk/provider-utils": "^4.0.27",
    "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@^5.0.29",
    "@ai-sdk/provider-v4": "npm:@ai-sdk/provider@^4.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^6.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.25.76",
    "ai-v7": "npm:ai@^7.0.77"
  },
  "packageManager": "pnpm@10.8.0"
}
